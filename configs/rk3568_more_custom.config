# ============================================================
# my-rk3568-prod.fragment  —— 生产/调试增强（叠加在 Part A 之后）
# ============================================================

# ---------- (1) USB / rockusb / fastboot / 镜像下载 ----------
CONFIG_USB=y
CONFIG_CMD_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_DWC3=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_GADGET=y
CONFIG_USB_DWC3_GENERIC=y
CONFIG_USB_GADGET=y
CONFIG_USB_GADGET_MANUFACTURER="Rockchip"
CONFIG_USB_GADGET_VENDOR_NUM=0x2207
CONFIG_USB_GADGET_PRODUCT_NUM=0x350a
CONFIG_USB_GADGET_DOWNLOAD=y            # ← rockusb 下载核心
CONFIG_USB_STORAGE=y
CONFIG_CMD_USB_MASS_STORAGE=y
CONFIG_USB_FUNCTION_MASS_STORAGE=y
CONFIG_ROCKUSB_G_DNL_PID=0x350a
CONFIG_FASTBOOT_BUF_ADDR=0xc00800
CONFIG_FASTBOOT_BUF_SIZE=0x04000000
CONFIG_FASTBOOT_FLASH=y
CONFIG_FASTBOOT_FLASH_MMC_DEV=0
CONFIG_PHY_ROCKCHIP_INNO_USB2=y
CONFIG_PHY_ROCKCHIP_NANENG_COMBOPHY=y

# ---------- (2) 以太网 + TFTP 下载 ----------
CONFIG_DM_ETH=y
CONFIG_DM_ETH_PHY=y
CONFIG_DWC_ETH_QOS=y
CONFIG_GMAC_ROCKCHIP=y
CONFIG_CMD_TFTPPUT=y
CONFIG_CMD_TFTP_BOOTM=y
CONFIG_CMD_TFTP_FLASH=y
CONFIG_NET_TFTP_VARS=y

# ---------- (3) 镜像/DTB 下载辅助 ----------
CONFIG_CMD_DTIMG=y

# ---------- (4) AVB 校验 ----------
CONFIG_ANDROID_BOOTLOADER=y
CONFIG_ANDROID_AVB=y
CONFIG_ANDROID_BOOT_IMAGE_HASH=y
CONFIG_CMD_BOOT_ANDROID=y
CONFIG_AVB_LIBAVB=y
CONFIG_AVB_LIBAVB_AB=y
CONFIG_AVB_LIBAVB_ATX=y
CONFIG_AVB_LIBAVB_USER=y
CONFIG_RK_AVB_LIBAVB_USER=y
CONFIG_ROCKCHIP_VENDOR_PARTITION=y

# ---------- (5) FIT 签名 / 安全启动链 ----------
# CONFIG_RSA=y
# CONFIG_SPL_RSA=y
# CONFIG_RSA_N_SIZE=0x200
# CONFIG_RSA_E_SIZE=0x10
# CONFIG_RSA_C_SIZE=0x20
# CONFIG_SHA256=y
# CONFIG_SHA512=y
# CONFIG_FIT_SIGNATURE=y
# CONFIG_SPL_FIT_SIGNATURE=y
# CONFIG_FIT_HW_CRYPTO=y
# CONFIG_SPL_FIT_HW_CRYPTO=y
# CONFIG_DM_CRYPTO=y
# CONFIG_SPL_DM_CRYPTO=y
# CONFIG_ROCKCHIP_CRYPTO_V2=y
# CONFIG_SPL_ROCKCHIP_CRYPTO_V2=y

# ---------- (6) 解压算法 ----------
CONFIG_SPL_GZIP=y
CONFIG_LZ4=y
CONFIG_LZMA=y
CONFIG_XBC=y
CONFIG_ERRNO_STR=y

# ---------- (7) OP-TEE 客户端 ----------
CONFIG_OPTEE_CLIENT=y
CONFIG_OPTEE_V2=y
CONFIG_OPTEE_ALWAYS_USE_SECURITY_PARTITION=y

# ---------- (8) 电源/按键/充电调试 ----------
CONFIG_DM_KEY=y
CONFIG_RK8XX_PWRKEY=y
CONFIG_ADC_KEY=y
CONFIG_DM_FUEL_GAUGE=y
CONFIG_POWER_FG_RK817=y
CONFIG_DM_CHARGE_DISPLAY=y
CONFIG_CHARGE_ANIMATION=y

# ---------- (8) 电源/按键/充电调试 ----------
# CONFIG_CONSOLE_DISABLE_CLI is not set
CONFIG_CONSOLE_DISABLE_CLI=n

